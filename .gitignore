# JavaScript dependencies and frontend build/cache output
node_modules/
/dist/
/.vite/
/.cache/
*.tsbuildinfo

# Rust / Tauri build output and generated schemas
/target/
/src-tauri/target/
/src-tauri/gen/
**/*.rs.bk

# Local environment and credentials (keep distributable examples)
.env
.env.*
!.env.example
!.env.*.example
!.env.template
!.env.*.template
.cargo/credentials
.cargo/credentials.toml

# Studio settings, conversation history, and atomic-save temporary files
.studio-state.*

# Strata runtime downloads, model packs, and local Python environments
/Strata-data/
/models/
/packs/
/mtp/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Logs and test artifacts
*.log
/logs/
/coverage/
/playwright-report/
/test-results/
/blob-report/

# OS and editor temporary files
.DS_Store
._*
Thumbs.db
Desktop.ini
.idea/
*.swp
*.swo
*~

# Keep Cargo.lock and package-lock.json tracked for reproducible app builds.
# Strata source files remain trackable; its own .gitignore handles engine output.
